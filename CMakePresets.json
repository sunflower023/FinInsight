{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-dev",
      "displayName": "Windows Dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.7.3/msvc2022_64"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.7.3/msvc2022_64"
      }
    },
    {
      "name": "win-mingw",
      "displayName": "Windows MinGW (offline deps)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.7.3/mingw_64",
        "CMAKE_CXX_COMPILER": "D:/Qt/Tools/mingw1120_64/bin/g++.exe",
        "BUILD_TESTING": "OFF",
        "FETCHCONTENT_SOURCE_DIR_QTADS": "${sourceDir}/third_party/qtads-src",
        "FETCHCONTENT_SOURCE_DIR_JSON": "${sourceDir}/third_party/json-src"
      },
      "environment": {
        "PATH": "D:/Qt/Tools/CMake_64/bin;D:/Qt/Tools/Ninja;D:/Qt/Tools/mingw1120_64/bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-dev",
      "configurePreset": "win-dev"
    },
    {
      "name": "win-release",
      "configurePreset": "win-release"
    },
    {
      "name": "win-mingw",
      "configurePreset": "win-mingw"
    }
  ]
}
